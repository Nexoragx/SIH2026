# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True
ENVIRONMENT=development

# Security / JWT Configuration
JWT_SECRET_KEY=sih26094_dynamic_mental_health_jwt_secret_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth2 Configuration (e.g. Google OAuth)
OAUTH_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
OAUTH_GOOGLE_CLIENT_SECRET=your_google_client_secret_here
OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/callback

# MongoDB Configuration (Localhost default, customizable via environment)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=mental_health_db

# Multi-modal Feature Fusion Weights (System Architecture)
WEIGHT_MADRS=0.40
WEIGHT_NLP=0.15
WEIGHT_VOICE=0.10
WEIGHT_CONTEXT=0.15
WEIGHT_BASELINE=0.20

# External Integration Stubs (Ambulance 108, Telepsychiatry, NGO Network)
CRISIS_AMBULANCE_108_API_ENDPOINT=https://api.emergency108.gov.in/v1/dispatch
CRISIS_AMBULANCE_108_API_KEY=mock_108_api_key_test_sandbox
TELEPSYCHIATRY_SERVICE_ENDPOINT=https://telepsych.portal.gov.in/v1
NGO_PARTNERSHIP_DISPATCH_ENDPOINT=https://ngo-network.mentalhealth.org/v1/assign
